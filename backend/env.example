# Configuración del FinOps AI Copilot

# OpenAI API Key
OPENAI_API_KEY=

# Modelo de LLM (opcional, default: gpt-4)
LLM_MODEL=

# Ruta al archivo de datos financieros (opcional, default: data/financials.xlsx)
FINANCIAL_DATA_PATH=data/Datos_Consolidados.xlsx

# === Elasticsearch / Vector Store (RAG de reglas de negocio) ===
ELASTICSEARCH_URL=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=

# === Elasticsearch / Vector Store (RAG Ley 27287 - Títulos de Valores) ===
ELASTICSEARCH_LEY27287_URL=
ELASTICSEARCH_LEY27287_USER=
ELASTICSEARCH_LEY27287_PASSWORD=
ELASTICSEARCH_LEY27287_INDEX=

# === LangSmith (Opcional - para monitoreo) ===
# Obtén tu API key en: https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# === PostgreSQL (Memoria del agente) ===
POSTGRES_DB_URI=
